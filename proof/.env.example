# DELEVA environment configuration.
# Copy to .env (gitignored) and fill in real values. Never commit a real
# KEEPERHUB_API_KEY -- this file must only ever contain placeholders.

# --- Chain / protocol addresses -------------------------------------------
# Defaults already match the real, proven Base mainnet deployment
# (see ../proof/DELEVA_TRANSACTION_PROOF.md); override only for a different
# chain or environment.
DELEVA_CHAIN=base
DELEVA_CHAIN_ID=8453
DELEVA_AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
DELEVA_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
DELEVA_WETH_ADDRESS=0x4200000000000000000000000000000000000006

# --- Monitored position -----------------------------------------------------
# The wallet DELEVA reads the Aave V3 position for. No safe default exists.
DELEVA_MONITORED_WALLET=0x0000000000000000000000000000000000dEaD

# --- Strategy thresholds -----------------------------------------------------
DELEVA_HF_TRIGGER_THRESHOLD=1.50
DELEVA_HF_TARGET=1.50

# --- KeeperHub -----------------------------------------------------------
KEEPERHUB_API_BASE_URL=https://app.keeperhub.com
# Secret -- never commit a real value.
KEEPERHUB_API_KEY=kh_replace_me

# --- Safety -----------------------------------------------------------
# Must be explicitly set to false by whatever assembles the real execution
# path once Phase 2 is authorized to broadcast. Defaults to true everywhere.
DELEVA_EXECUTION_DRY_RUN=true
